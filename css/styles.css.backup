
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Arial', sans-serif;
    background: #f4f4f4;
}

:root {
    --primary: #1a5f3a;
    --secondary: #ffcc00;
    --dark: #222;
    --light: #fff;
}

